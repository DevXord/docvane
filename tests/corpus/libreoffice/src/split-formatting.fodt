<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <!-- Tags split by changes of formatting and by bookmarks. Written for docvane tests; MIT. -->
 <office:automatic-styles>
  <style:style style:name="B" style:family="text"><style:text-properties fo:font-weight="bold"/></style:style>
  <style:style style:name="I" style:family="text"><style:text-properties fo:font-style="italic"/></style:style>
  <style:style style:name="U" style:family="text"><style:text-properties style:text-underline-style="solid" style:text-underline-width="auto" style:text-underline-color="font-color"/></style:style>
 </office:automatic-styles>
 <office:body><office:text>
  <text:p>Dear {cust<text:span text:style-name="B">omer.na</text:span>me},</text:p>
  <text:p>Total: {<text:span text:style-name="I">total</text:span> | <text:span text:style-name="B">currency</text:span>(„PLN”)}.</text:p>
  <text:p>{#<text:bookmark-start text:name="b1"/>items<text:bookmark-end text:name="b1"/>}</text:p>
  <text:p>- {<text:span text:style-name="U">n</text:span><text:span text:style-name="B">a</text:span><text:span text:style-name="I">m</text:span>e}: {price | number(2)}</text:p>
  <text:p>{/it<text:span text:style-name="B">ems</text:span>}</text:p>
  <text:p>{#isVip}Thank you for being a VIP.{/is<text:bookmark text:name="b2"/>Vip}{^items}No items.{/items}</text:p>
  <text:p>Notes: {~sum<text:span text:style-name="I">mary</text:span>} and logo {%lo<text:span text:style-name="B">go</text:span>}</text:p>
 </office:text></office:body>
</office:document>
