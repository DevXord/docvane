<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <!-- The offer template of the docvane README and CLI examples. Written for docvane; MIT. -->
 <office:styles>
  <style:style style:name="Standard" style:family="paragraph"/>
  <style:style style:name="Title" style:display-name="Title" style:family="paragraph"><style:text-properties fo:font-size="20pt" fo:font-weight="bold"/></style:style>
  <style:style style:name="List_20_Bullet" style:display-name="List Bullet" style:family="paragraph" style:list-style-name="Bullets"/>
  <text:list-style style:name="Bullets"><text:list-level-style-bullet text:level="1" text:bullet-char="•"><style:list-level-properties text:min-label-width="0.5cm"/></text:list-level-style-bullet></text:list-style>
 </office:styles>
 <office:automatic-styles>
  <style:style style:name="B" style:family="text"><style:text-properties fo:font-weight="bold"/></style:style>
 </office:automatic-styles>
 <office:body><office:text>
  <text:p>{%logo}</text:p>
  <text:p text:style-name="Title">Offer {number}</text:p>
  <text:p>For <text:span text:style-name="B">{customer.name}</text:span>, {customer.company}</text:p>
  <text:p>Date: {date | date("long")}</text:p>
  <table:table table:name="Items"><table:table-column table:number-columns-repeated="4"/>
   <table:table-row><table:table-cell><text:p>Product</text:p></table:table-cell><table:table-cell><text:p>Qty</text:p></table:table-cell><table:table-cell><text:p>Price</text:p></table:table-cell><table:table-cell><text:p>Total</text:p></table:table-cell></table:table-row>
   <table:table-row><table:table-cell><text:p>{#items}{name}</text:p></table:table-cell><table:table-cell><text:p>{qty}</text:p></table:table-cell><table:table-cell><text:p>{price | currency("EUR")}</text:p></table:table-cell><table:table-cell><text:p>{total | currency("EUR")}{/items}</text:p></table:table-cell></table:table-row>
  </table:table>
  <text:p>Total: <text:span text:style-name="B">{sum | currency("EUR")}</text:span></text:p>
  <text:p>{#vip}As a VIP customer you get free delivery.{/vip}</text:p>
  <text:p>{~notes}</text:p>
  <text:p>Regards, {author}</text:p>
 </office:text></office:body>
</office:document>
