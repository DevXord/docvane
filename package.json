{
  "name": "tplvane-monorepo",
  "private": true,
  "type": "module",
  "description": "Monorepo for tplvane and @tplvane/mcp.",
  "license": "MIT",
  "workspaces": [
    "packages/tplvane",
    "packages/mcp"
  ],
  "packageManager": "npm@11.21.1",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.16.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "test": "vitest run",
    "fuzz": "vitest run --config vitest.fuzz.config.ts",
    "test:libreoffice": "TV_LIBREOFFICE=1 vitest run tests/libreoffice",
    "build": "npm run build --workspaces",
    "typecheck": "npm run build --silent && tsc -p tsconfig.json && tsc -p packages/tplvane/tsconfig.json && tsc -p packages/mcp/tsconfig.json",
    "check:pkg": "node scripts/check-pkg.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@modelcontextprotocol/client": "2.4.0",
    "fast-check": "4.10.2",
    "publint": "0.3.25",
    "tsdown": "0.23.4",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "fsevents": false
  }
}
