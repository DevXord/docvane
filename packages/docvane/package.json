{
  "name": "docvane",
  "version": "0.0.0",
  "description": "Fill Word, PowerPoint and Excel templates with one syntax; templates and data are treated as untrusted. ESM only.",
  "keywords": [
    "docx",
    "pptx",
    "xlsx",
    "template",
    "ooxml"
  ],
  "license": "MIT",
  "homepage": "https://github.com/DevXord/docvane#readme",
  "bugs": {
    "url": "https://github.com/DevXord/docvane/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevXord/docvane.git",
    "directory": "packages/docvane"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "xlvane": "^1.3.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
