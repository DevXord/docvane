{
  "name": "tplvane",
  "version": "1.0.0",
  "description": "Fill Word, PowerPoint and Excel templates with one syntax; templates and data are treated as untrusted. ESM only.",
  "keywords": [
    "docx",
    "pptx",
    "xlsx",
    "template",
    "ooxml",
    "word",
    "powerpoint",
    "excel",
    "docxtemplater",
    "report",
    "mail-merge"
  ],
  "license": "MIT",
  "homepage": "https://tplvane.github.io/",
  "bugs": {
    "url": "https://github.com/DevXord/tplvane/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevXord/tplvane.git",
    "directory": "packages/tplvane"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "tplvane": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "skills",
    "llms-full.txt",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ../../scripts/copy-docs.mjs && tsdown"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "xlvane": "^1.3.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
