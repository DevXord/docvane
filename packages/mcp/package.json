{
  "name": "@tplvane/mcp",
  "version": "1.0.0",
  "description": "MCP server for filling Word, PowerPoint and Excel templates with tplvane, limited to the directories given at start.",
  "keywords": [
    "docx",
    "pptx",
    "xlsx",
    "template",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "homepage": "https://tplvane.github.io/guide/mcp.html",
  "bugs": {
    "url": "https://github.com/DevXord/tplvane/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DevXord/tplvane.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "tplvane-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "tplvane": "^1.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
